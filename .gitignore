# Python
__pycache__/
*.py[co]
.venv/
venv/
.pytest_cache/

# Local data. The store is PostgreSQL as of feature 006 and lives in a container, not in
# a file — these patterns stay only so a stray database file from before the cutover can
# never be committed. Nothing the app reads or writes matches them.
*.db
*.sqlite

# Secrets — real k8s Secrets and credentials never land in git (deploy/secret.example.yaml
# is the committed template). Payment adds a Steam API key to the set of things to keep out.
*.secret.yaml
*.secret.yml
kubeconfig*
*.key
*.crt
*.pem

# Env / editor
.env*
*.log
.DS_Store
.idea/
.vscode/
